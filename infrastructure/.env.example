# Copy to .env for local Docker Compose runs. Keep real secrets out of source control.
DB_NAME=aaharrakshak
DB_USERNAME=aahar
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root
JWT_SECRET=replace-with-at-least-64-random-characters-before-production
CORS_ALLOWED_ORIGINS=http://localhost:5080,http://localhost:8080,http://10.0.2.2:8080
PUBLIC_BASE_URL=http://localhost:8080
REDIS_PORT=6379
MINIO_ROOT_USER=aaharminio
MINIO_ROOT_PASSWORD=change-minio-password
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=25MB
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
ERROR_METRICS_ENABLED=true
ASPNETCORE_ENVIRONMENT=Production
