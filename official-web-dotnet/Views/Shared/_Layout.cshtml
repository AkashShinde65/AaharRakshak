<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AaharRakshak Portal</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/official_web_dotnet.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-area="Public" asp-controller="Reports" asp-action="Index">AaharRakshak</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Public" asp-controller="Reports" asp-action="Index">Public Reports</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Public" asp-controller="Reports" asp-action="Alerts">Recalls & Alerts</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Public" asp-controller="Reports" asp-action="Trust">Trust Score</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Public" asp-controller="Reports" asp-action="Licence">Licence Status</a>
                        </li>
                        @if (User.IsInRole("COMPANY"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Company" asp-controller="Dashboard" asp-action="Index">Company Notices</a>
                            </li>
                        }
                        @if (User.IsInRole("FOOD_INSPECTOR") || User.IsInRole("LABORATORY_OFFICER") || User.IsInRole("DISTRICT_ESCALATION_OFFICER") || User.IsInRole("CENTRAL_ADMINISTRATOR"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Official" asp-controller="Dashboard" asp-action="Index">Official Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Official" asp-controller="Dashboard" asp-action="Notices">Action Notices</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Official" asp-controller="Dashboard" asp-action="Hotspots">Hotspots</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Official" asp-controller="Dashboard" asp-action="Escalations">Escalations</a>
                            </li>
                            @if (User.IsInRole("DISTRICT_ESCALATION_OFFICER") || User.IsInRole("CENTRAL_ADMINISTRATOR"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="Official" asp-controller="Dashboard" asp-action="Alerts">Alert Ops</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-muted">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-link nav-link text-dark" type="submit">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Auth" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - AaharRakshak academic demo portal
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
