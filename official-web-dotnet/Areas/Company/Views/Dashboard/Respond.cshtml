@model official_web_dotnet.Models.CompanyResponseFormViewModel
@{
    ViewData["Title"] = "Submit Response";
}

<h1 class="h4 page-title">Submit Company Response</h1>
<div class="surface">
    <form asp-action="Respond" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="NoticeNumber" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="ResponseText" class="form-label"></label>
            <textarea asp-for="ResponseText" class="form-control" rows="4"></textarea>
            <span asp-validation-for="ResponseText" class="text-danger"></span>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="ObjectKey" class="form-label"></label>
                <input asp-for="ObjectKey" class="form-control" />
                <span asp-validation-for="ObjectKey" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="OriginalFileName" class="form-label"></label>
                <input asp-for="OriginalFileName" class="form-control" />
                <span asp-validation-for="OriginalFileName" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ContentType" class="form-label"></label>
                <input asp-for="ContentType" class="form-control" />
                <span asp-validation-for="ContentType" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="SizeBytes" class="form-label"></label>
                <input asp-for="SizeBytes" class="form-control" />
                <span asp-validation-for="SizeBytes" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ChecksumSha256" class="form-label"></label>
                <input asp-for="ChecksumSha256" class="form-control" />
                <span asp-validation-for="ChecksumSha256" class="text-danger"></span>
            </div>
        </div>
        <div class="mt-3">
            <button class="btn btn-primary" type="submit">Submit Response</button>
            <a class="btn btn-link" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
